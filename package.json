{
  "name": "haijiang-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack && node scripts/postbuild.mjs",
    "preview": "serve dist --listen tcp://0.0.0.0:4321",
    "check": "next typegen --webpack && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm test && npm run build && node scripts/check-links.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@shikijs/rehype": "^3.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "serve": "^14.2.4",
    "typescript": "^5.9.3"
  }
}
