---
import maps from '../data/english/word-maps.json';
interface Props { name: string; }
const map=maps.find(item=>item.name===Astro.props.name);
if(!map) throw new Error(`Unknown word meaning map: ${Astro.props.name}`);
---
<figure class="word-meaning-map" data-meaning-map={map.name} data-source={map.code}>
  <div class="map-heading"><strong>{map.title}</strong><button type="button" data-map-expand disabled>放大查看</button></div>
  <div class="map-viewport" tabindex="0" role="region" aria-label={map.title}><div class="map-canvas"></div></div>
  <p class="map-status" role="status">正在准备关系图；下方文字也说明了相同关系。</p>
  <figcaption>{map.description}</figcaption>
  <dialog aria-label={`${map.title} · 大图`}><div class="map-dialog-heading"><strong>{map.title}</strong><button type="button" data-map-close>关闭大图</button></div><div class="map-modal-canvas"></div><p>{map.description}</p></dialog>
</figure>
<style>.word-meaning-map{border:1px solid var(--lab-border);border-radius:.6rem;padding:1rem;background:var(--lab-surface);margin:1.5rem 0;min-width:0}.map-heading{display:flex;justify-content:space-between;align-items:start;gap:.6rem;font-size:.9rem}.map-heading button,.map-dialog-heading button{border:1px solid var(--lab-border);padding:.4rem .6rem;background:var(--lab-soft);color:var(--lab-ink);border-radius:.4rem;font:inherit;font-size:.8rem;white-space:nowrap;cursor:pointer}.map-heading button:disabled{opacity:.5;cursor:wait}.map-viewport{overflow:auto;max-width:100%;padding:.7rem 0}.map-canvas{min-width:480px}.map-canvas :global(svg){display:block;width:100%;height:auto;min-height:9rem}.map-status{font-size:.75rem;color:var(--lab-muted);margin:.3rem 0!important}.word-meaning-map figcaption{font-size:.875rem;line-height:1.8;color:var(--lab-muted)}dialog{width:min(95vw,1200px);max-height:92dvh;border:1px solid var(--lab-border);border-radius:.7rem;padding:1.2rem;background:var(--lab-bg);color:var(--lab-ink);overflow:auto}dialog::backdrop{background:#10221dcc}.map-dialog-heading{display:flex;justify-content:space-between;align-items:start;gap:1rem;margin-bottom:1rem}.map-modal-canvas{overflow:auto}.map-modal-canvas .map-canvas{min-width:720px}.map-modal-canvas :global(svg){max-width:none!important;width:100%!important}dialog p{font-size:.9rem}@media(max-width:500px){.word-meaning-map{padding:.75rem}.map-heading{flex-direction:column}}</style>
<script>
  const figures=[...document.querySelectorAll<HTMLElement>('[data-meaning-map]')];
  const load=()=>import('mermaid').then(module=>module.default);
  let engine: ReturnType<typeof load> | undefined;
  let sequence=Promise.resolve();
  let renderIndex=0;
  function schedule(figure: HTMLElement){
    sequence=sequence.then(async()=>{
      const theme=document.documentElement.dataset.theme==='dark'?'dark':'light';
      if(figure.dataset.renderedTheme===theme)return;
      try{
        engine??=load();const mermaid=await engine;
        mermaid.initialize({startOnLoad:false,securityLevel:'strict',suppressErrorRendering:true,theme:'base',fontFamily:'system-ui, sans-serif',flowchart:{htmlLabels:false,useMaxWidth:true,wrappingWidth:220,nodeSpacing:30,rankSpacing:35},themeVariables:{fontSize:'16px',primaryColor:theme==='dark'?'#223c30':'#eef4e9',primaryTextColor:theme==='dark'?'#edf5f0':'#23362c',primaryBorderColor:theme==='dark'?'#83c9ae':'#92b5a2',lineColor:theme==='dark'?'#a6b7ad':'#668b76',secondaryColor:theme==='dark'?'#1c2521':'#f7f9f4',tertiaryColor:theme==='dark'?'#141b19':'#ffffff'}});
        const {svg}=await mermaid.render(`word-map-${++renderIndex}`,figure.dataset.source!);
        figure.querySelector('.map-canvas')!.innerHTML=svg;
        figure.dataset.renderedTheme=theme;
        figure.querySelector('.map-status')!.textContent='关系图可左右滑动，也可放大查看。';
        figure.querySelector<HTMLButtonElement>('[data-map-expand]')!.disabled=false;
      }catch{
        figure.querySelector('.map-status')!.textContent='关系图暂时无法显示。请先阅读下方的关系说明。';
      }
    });
  }
  for(const figure of figures){
    const dialog=figure.querySelector<HTMLDialogElement>('dialog')!;
    const canvas=figure.querySelector<HTMLElement>('.map-canvas')!;
    const opener=figure.querySelector<HTMLButtonElement>('[data-map-expand]')!;
    opener.addEventListener('click',()=>{figure.querySelector('.map-modal-canvas')!.append(canvas);dialog.showModal();});
    figure.querySelector('[data-map-close]')!.addEventListener('click',()=>dialog.close());
    dialog.addEventListener('close',()=>{figure.querySelector('.map-viewport')!.append(canvas);opener.focus();});
  }
  if('IntersectionObserver' in window){const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){schedule(entry.target as HTMLElement);observer.unobserve(entry.target);}}),{rootMargin:'300px'});figures.forEach(figure=>observer.observe(figure));}else figures.forEach(schedule);
  new MutationObserver(()=>figures.filter(figure=>figure.dataset.renderedTheme).forEach(schedule)).observe(document.documentElement,{attributes:true,attributeFilter:['data-theme']});
</script>
