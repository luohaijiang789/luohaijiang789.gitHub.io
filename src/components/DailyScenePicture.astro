---
interface Props { visual: string; label: string; }
const {visual, label} = Astro.props;
---
<svg viewBox="0 0 480 230" role="img" aria-label={label} fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="daily-scene-picture">
  <rect x="1" y="1" width="478" height="228" rx="16" fill="var(--lab-soft)" stroke="none"/>
  {visual === 'cafe' && <g><path d="M75 170h329M99 171v34m278-34v34"/><path d="M124 95h78v46q-39 38-78 0V95Zm78 8h20v28h-20m-66-53V61m20 17V53m20 25V61" fill="var(--lab-surface)"/><rect x="262" y="42" width="114" height="101" rx="10" fill="var(--lab-surface)"/><path d="M280 73h78m-78 24h51m-51 22h64"/><text x="110" y="195" font-size="12" fill="currentColor" stroke="none">FOR HERE?</text><text x="271" y="195" font-size="12" fill="currentColor" stroke="none">TO GO?</text></g>}
  {visual === 'directions' && <g><path d="M219 36v161m-77-95h79m0 41h80"/><path d="M120 60h112v35H120l-22-17 22-18Zm132 68h105l22 18-22 18H252v-36Z" fill="var(--lab-surface)"/><text x="132" y="83" font-size="14" fill="currentColor" stroke="none">STATION</text><text x="266" y="152" font-size="14" fill="currentColor" stroke="none">LIBRARY</text><path d="M178 204h85M84 160h55m-10-10 10 10-10 10"/></g>}
  {visual === 'shopping' && <g><path d="M93 62h30l23 102h148l27-76H129"/><circle cx="167" cy="185" r="12" fill="var(--lab-surface)"/><circle cx="273" cy="185" r="12" fill="var(--lab-surface)"/><path d="M176 89V59h43v54m21-25V47h37v65"/><path d="M345 54h64v133l-10-7-10 7-11-7-11 7-11-7-11 7V54Z" fill="var(--lab-surface)"/><path d="M359 76h36m-36 23h36m-36 23h22m-22 27h36"/></g>}
  {visual === 'housing' && <g><path d="m90 110 100-73 100 73M111 98v95h158V98" fill="var(--lab-surface)"/><path d="M169 193v-69h44v69m-81-77h24v28h-24zm102 0h23v28h-23z"/><circle cx="355" cy="111" r="24" fill="var(--lab-surface)"/><path d="m355 135-1 52m0-17h19m-19 12h12"/><text x="315" y="55" font-size="13" fill="currentColor" stroke="none">AVAILABLE?</text></g>}
  {visual === 'calendar' && <g><rect x="110" y="47" width="203" height="139" rx="12" fill="var(--lab-surface)"/><path d="M110 83h203M150 35v25m121-25v25M137 109h25m27 0h25m27 0h25m-129 28h25m27 0h25"/><rect x="240" y="123" width="35" height="29" rx="5" fill="var(--lab-soft)"/><path d="M172 157c49 39 120 26 156-10m-4-13 7 13-16-1"/><text x="143" y="210" font-size="13" fill="currentColor" stroke="none">A NEW TIME THAT WORKS.</text></g>}
  {visual === 'conversation' && <g><rect x="58" y="39" width="182" height="74" rx="15" fill="var(--lab-surface)"/><path d="m110 113-9 18 30-18"/><rect x="246" y="99" width="179" height="68" rx="15" fill="var(--lab-surface)"/><path d="m368 167 10 18-31-18"/><text x="78" y="82" font-size="16" fill="currentColor" stroke="none">How was your weekend?</text><text x="272" y="139" font-size="16" fill="currentColor" stroke="none">How about you?</text><circle cx="134" cy="168" r="19"/><path d="M102 210v-9q32-29 64 0v9"/></g>}
</svg>
<style>.daily-scene-picture{display:block;width:100%;height:auto;color:var(--lab-accent)}</style>
