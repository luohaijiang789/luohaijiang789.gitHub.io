---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
import { lessons } from '../data/english/curriculum.mjs';
const slug = Astro.locals.starlightRoute.id.replace(/^english\//, '');
const index = lessons.findIndex(lesson => lesson.slug === slug);
const lesson = lessons[index];
const previous = lessons[index - 1];
const next = lessons[index + 1];
---
{lesson && <section class="course-lesson-footer" aria-label="本节完成与章节导航"><p><a href={`/english/${lesson.sectionSlug}/`}>{lesson.section}</a> / {lesson.unit}</p><label><input type="checkbox" data-course-complete={slug}/><span>我已独立完成本节练习，并核对了解析</span></label><p class="course-save-status" role="status">标记保存在当前浏览器，包含在学习备份中。</p><nav aria-label="课程章节导航">{previous ? <a href={`/english/${previous.slug}/`}><small>上一节</small><span>{previous.title}</span></a> : <a href="/english/"><small>课程入口</small><span>英语学习手册</span></a>}{next ? <a href={`/english/${next.slug}/`}><small>下一节</small><span>{next.title}</span></a> : <a href="/english/"><small>回到总目录</small><span>继续查缺补漏</span></a>}</nav></section>}
<DefaultFooter><slot /></DefaultFooter>
<style>.course-lesson-footer>p a{color:var(--lab-accent)}.course-lesson-footer{border-top:1px solid var(--lab-border);margin-top:2rem;padding-top:1.3rem;font-size:.9rem}.course-lesson-footer>p:first-child{color:var(--lab-muted);font-size:.8rem}.course-lesson-footer label{display:flex;align-items:start;gap:.7rem;margin:.8rem 0;cursor:pointer}.course-lesson-footer input{width:1.1rem;height:1.1rem;margin-top:.25rem;accent-color:var(--lab-accent);flex-shrink:0}.course-save-status{font-size:.75rem;color:var(--lab-muted)}.course-lesson-footer nav{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin-top:1.2rem}.course-lesson-footer nav a{display:flex;flex-direction:column;gap:.5rem;border:1px solid var(--lab-border);border-radius:.5rem;padding:.9rem;color:var(--lab-ink);text-decoration:none}.course-lesson-footer nav small{color:var(--lab-muted);font-size:.75rem}.course-lesson-footer nav a:hover{border-color:var(--lab-accent)}@media(max-width:480px){.course-lesson-footer nav{grid-template-columns:1fr}}</style>
<script>
  import { readProgress, writeProgress } from '../lib/progress.mjs';
  const input=document.querySelector<HTMLInputElement>('[data-course-complete]');
  if(input){
    const id=input.dataset.courseComplete!; input.checked=readProgress().english.completedLessons.includes(id);
    input.addEventListener('change',()=>{
      const p=readProgress();p.english.completedLessons=input.checked?[...new Set([...p.english.completedLessons,id])]:p.english.completedLessons.filter(slug=>slug!==id);
      const saved=writeProgress(p);if(!saved)input.checked=!input.checked;
      document.querySelector('.course-save-status')!.textContent=saved?'本节完成标记已保存，可在复习页导出备份。':'浏览器无法保存，请检查存储设置。';
    });
  }
</script>
