---
import { getCollection } from 'astro:content';
const notes = (await getCollection('docs')).filter(note => note.id.startsWith('notes/')).sort((a,b) => (a.data.sidebar.order ?? 100) - (b.data.sidebar.order ?? 100));
const topics: Record<string,string> = { http: '网络基础', 'software-delivery': '工程基础', 'tool-boundaries': 'AI 安全', 'tool-guard': '权限实验', evidence: '技术思考', 'visual-explanation': '技术图解', 'job-research': '职业研究' };
const summaries: Record<string,string> = { http: '沿着一次请求，理解身份认证、资源访问与授权检查。', 'software-delivery': '分清源码、依赖、命令执行与容器，理解各种方式的组合关系。', 'tool-boundaries': '模型提出调用后，独立执行层如何检查权限？', 'tool-guard': '一个可以运行与测试的默认拒绝授权规则。', evidence: '区分观察、推断与结论，让实验结果支持恰当的判断。', 'visual-explanation': '用位置、边界与文字，画出能讲清问题的技术图。', 'job-research': '用真实岗位与项目证据，分析能力差距和下一步。' };
---
<div class="notes-meta">全部笔记 <span>{notes.length} 篇</span></div>
<ul class="notes-list">
  {notes.map(note => {
    const slug=note.id.split('/').pop()!;
    return <li><a href={`/${note.id}/`}><span class="note-topic">{topics[slug] ?? '技术笔记'}</span><span class="note-title">{note.data.title}</span><span class="note-description">{note.data.description || summaries[slug]}</span></a></li>;
  })}
</ul>
<style>
.notes-meta{display:flex;justify-content:space-between;margin:2.5rem 0 .5rem;color:var(--lab-muted);font-size:.875rem}
.notes-list{list-style:none;padding:0!important;margin:0!important}
.notes-list li{margin:0!important;border-top:1px solid var(--lab-border)}
.notes-list li:last-child{border-bottom:1px solid var(--lab-border)}
.notes-list a{display:block;padding:1.4rem .25rem;text-decoration:none;color:var(--lab-ink);border-radius:.25rem}
.notes-list a:hover{background:var(--lab-soft)}
.notes-list a>*{display:block;margin:0}
.note-topic{font-size:.875rem;color:var(--lab-accent)}
.note-title{font-size:1.15rem;font-weight:650;line-height:1.6;margin-top:.25rem!important}
.note-description{font-size:1rem;color:var(--lab-muted);line-height:1.8;margin-top:.35rem!important}
</style>
