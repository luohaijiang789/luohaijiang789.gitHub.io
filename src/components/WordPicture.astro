---
interface Props { visual: string; label: string; }
const { visual, label } = Astro.props;
---
<svg viewBox="0 0 360 220" role="img" aria-label={label} class="word-picture" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
  <rect x="1" y="1" width="358" height="218" rx="18" fill="var(--lab-soft)" stroke="none"/>
  {visual === 'inspect' && <g><rect x="90" y="48" width="125" height="130" rx="12" fill="var(--lab-surface)"/><path d="M112 74h78m-78 24h60m-60 24h78m-78 24h45"/><circle cx="219" cy="133" r="36" fill="var(--lab-soft)"/><path d="m245 160 30 30m-75-56 12 12 22-25"/></g>}
  {visual === 'predict' && <g><path d="M45 169h270M85 161v16m190-16v16"/><circle cx="85" cy="109" r="18" fill="var(--lab-surface)"/><path d="M85 128v25m-20-12 20-9 20 9"/><path d="M115 110c50-50 92-40 130-11" stroke-dasharray="6 8"/><rect x="240" y="59" width="74" height="71" rx="12" fill="var(--lab-surface)"/><path d="M253 79h47m-24-7v44m-19-20 12 9 23-20"/><text x="71" y="199" font-size="13" fill="currentColor" stroke="none">NOW</text><text x="246" y="199" font-size="13" fill="currentColor" stroke="none">FUTURE?</text></g>}
  {visual === 'transport' && <g><path d="M35 171h290m-260 0v21m231-21v21"/><rect x="98" y="83" width="116" height="66" rx="7" fill="var(--lab-surface)"/><path d="M214 104h29l25 25v20h-54m10-36v20h31"/><circle cx="125" cy="155" r="15" fill="var(--lab-soft)"/><circle cx="239" cy="155" r="15" fill="var(--lab-soft)"/><path d="M55 63h66m117 0h63m-14-10 14 10-14 10M127 96h42v36h-42zm21 0v13"/><text x="51" y="195" font-size="14" fill="currentColor" stroke="none">A</text><text x="299" y="195" font-size="14" fill="currentColor" stroke="none">B</text></g>}
  {visual === 'review' && <g><rect x="126" y="52" width="103" height="126" rx="10" fill="var(--lab-surface)"/><path d="M146 79h59m-59 22h59m-59 22h45m-45 22h39M98 144c-30-64 12-110 71-112m-9-10 12 10-10 12m84 28c31 57 1 112-56 123m9 9-13-9 8-13"/></g>}
  {visual === 'reconnect' && <g><path d="M40 118h75m130 0h75M115 94h42v48h-42zm88 0h42v48h-42zM157 105h18m-18 26h18m10-37v48M115 66c39-30 83-29 129 0m-9-15 11 16-20-1"/><circle cx="180" cy="174" r="16" fill="var(--lab-surface)"/><path d="m172 174 6 6 11-13"/></g>}
  {visual === 'unsafe' && <g><path d="m180 40 91 139H89L180 40Z" fill="var(--lab-surface)"/><path d="M180 87v42m0 19v5M47 190h78m108 0h78m-153-9 43 20m-43 0 43-20"/><path d="M66 165v25m228-25v25"/></g>}
  {visual === 'access' && <g><path d="M139 185V42h110v143M153 185V58h78v127"/><circle cx="211" cy="122" r="4"/><circle cx="92" cy="115" r="16"/><path d="M76 185v-36q16-25 32 0v36m-9-34h31"/><rect x="271" y="91" width="48" height="62" rx="6" fill="var(--lab-surface)"/><path d="m281 120 8 8 20-21"/><path d="M42 185h276"/></g>}
  {visual === 'available' && <g><rect x="84" y="48" width="192" height="139" rx="12" fill="var(--lab-surface)"/><path d="M84 83h192M126 35v27m108-27v27M108 108h26m22 0h26m22 0h26m-122 29h26m70 0h26m-122 29h26m22 0h26"/><rect x="153" y="121" width="36" height="30" rx="6" fill="var(--lab-soft)"/><path d="m160 136 7 7 15-17"/></g>}
  {visual === 'receipt' && <g><path d="M123 39h114v145l-14-9-14 9-15-9-14 9-15-9-14 9-14-9-14 9V39Z" fill="var(--lab-surface)"/><path d="M145 66h69m-69 24h69m-69 24h69m-69 25h33m20 0h16M93 192h174"/><circle cx="273" cy="128" r="20" fill="var(--lab-soft)"/><path d="m264 128 7 7 12-15"/></g>}
  {visual === 'helpful' && <g><circle cx="105" cy="64" r="17"/><circle cx="254" cy="64" r="17"/><path d="M83 106q22-23 44 0l21 36m-65-36v76m20-36v36m173-76q-22-23-44 0l-20 36m64-36v76m-20-36v36"/><rect x="149" y="101" width="62" height="49" rx="5" fill="var(--lab-surface)"/><path d="M180 101v16m-41 39h82M61 189h237"/></g>}
  {visual === 'careless' && <g><path d="M66 147h228m-200 0v43m171-43v43M218 93l32-11 14 39-32 11-14-39Zm35-7 12-5 8 21-13 5" fill="var(--lab-surface)"/><path d="M277 123q16 8 10 18m-6 20 4 6m-11-5 1 8m20-9 5 5M124 49h46m-37 0-13 19m17 7v27m-11-12 11-7 17 15m-17 4-10 28m10-28 19 26"/><path d="m98 51 5-6m-15 9h-8"/></g>}
</svg>
<style>.word-picture{display:block;width:100%;height:auto;color:var(--lab-accent)}</style>
