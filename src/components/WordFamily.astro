---
const families = [
  { word: 'allow', meaning: '允许', related: 'allowed', phrase: 'be allowed to do something', note: '被允许做某事' },
  { word: 'permission', meaning: '许可', related: 'permissible', phrase: 'have permission to read a file', note: '有权读取一个文件；permissible 偏正式' },
  { word: 'clear', meaning: '清楚的', related: 'clarify · clarification', phrase: 'Could you clarify what you mean?', note: '澄清 → 进一步说明' },
];
---
<div class="word-families" aria-label="英语词族联系图">
  {families.map(family => <div class="word-family"><div class="family-root"><strong lang="en">{family.word}</strong><span>{family.meaning}</span></div><div class="family-branch"><span lang="en">{family.related}</span><small>{family.note}</small></div><p lang="en">{family.phrase}</p></div>)}
</div>
<div class="affix-examples"><div><span class="affix">re-</span><span> + </span><strong>view</strong><span> = </span><strong>review</strong><p>再看一次 → 回顾、复查</p></div><div><span class="affix">un-</span><span> + </span><strong>authorized</strong><span> = </span><strong>unauthorized</strong><p>未获授权的 → unauthorized access</p></div></div>
<style>.word-families{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem;margin:1.5rem 0}.word-family{border:1px solid var(--lab-border);border-radius:.7rem;padding:1rem;background:var(--lab-surface)}.family-root{display:flex;flex-direction:column}.family-root strong{font-size:1.2rem;color:var(--lab-accent)}.family-root span{font-size:.8rem;color:var(--lab-muted)}.family-branch{margin:1rem 0 0 .3rem;padding:.3rem 0 .3rem .8rem;border-left:2px solid var(--lab-border)}.family-branch>span{font-size:.9rem;overflow-wrap:anywhere}.family-branch small{display:block;font-size:.75rem;color:var(--lab-muted)}.word-family p{font-size:.875rem;border-top:1px solid var(--lab-border);padding-top:.7rem;line-height:1.7}.affix-examples{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}.affix-examples>div{padding:1rem;border-radius:.5rem;background:var(--lab-soft);font-size:.9rem;overflow-wrap:anywhere}.affix{display:inline-block;color:var(--lab-accent);padding:.1rem .4rem;border:1px solid var(--lab-accent);border-radius:.3rem;font-weight:700}.affix-examples p{font-size:.85rem;color:var(--lab-muted);margin:.5rem 0 0}@media(max-width:700px){.word-families,.affix-examples{grid-template-columns:1fr}.family-root{flex-direction:row;gap:.6rem;align-items:baseline}}</style>
