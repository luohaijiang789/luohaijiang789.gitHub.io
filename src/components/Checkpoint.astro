---
import questions from '../data/english/checkpoint.json';
---
<form class="course-checkpoint" data-course-checkpoint><p>可以先做一部分再核对。答案不会用于推断总体英语水平，也不会上传。</p>{questions.map((q,i)=><fieldset data-question={q.id}><legend>{i+1}. {q.prompt}</legend>{q.options.map((option,index)=><label><input type="radio" name={`check-${q.id}`} value={index}/><span>{option}</span></label>)}<div class="question-explanation" hidden><strong data-question-status></strong><p>参考答案：{q.options[q.answer]}</p><p>{q.explanation}</p><a href={`/english/${q.lesson}/`}>回到对应章节</a></div></fieldset>)}<div class="component-actions"><button type="submit">核对答案与解析</button><button type="reset">重新作答</button></div><p data-checkpoint-result role="status"></p></form>
<style>.course-checkpoint{margin:1.2rem 0}.course-checkpoint fieldset{margin:1rem 0;padding:1rem;border:1px solid var(--lab-border);border-radius:.5rem;min-width:0}.course-checkpoint legend{font-size:1rem;font-weight:600;padding:0 .3rem}.course-checkpoint label{display:flex;gap:.6rem;align-items:start;padding:.5rem 0;font-size:.9rem;cursor:pointer}.course-checkpoint input{margin-top:.35rem;flex-shrink:0;accent-color:var(--lab-accent)}.question-explanation{padding:1rem;background:var(--lab-soft);border-radius:.4rem;font-size:.9rem;margin-top:.7rem}.question-explanation p{margin:.4rem 0!important}.course-checkpoint button{border:1px solid var(--lab-border);padding:.6rem .8rem;border-radius:.4rem;background:var(--lab-soft);color:var(--lab-ink);font:inherit;font-size:.9rem;cursor:pointer}[data-checkpoint-result]{color:var(--lab-accent);font-size:.9rem}[hidden]{display:none!important}</style>
<script>
 import questions from '../data/english/checkpoint.json';
 const form=document.querySelector<HTMLFormElement>('[data-course-checkpoint]')!;const result=document.querySelector('[data-checkpoint-result]')!;
 form.addEventListener('submit',event=>{event.preventDefault();let answered=0,correct=0;const data=new FormData(form);questions.forEach(q=>{const value=data.get(`check-${q.id}`);const field=form.querySelector<HTMLElement>(`[data-question="${q.id}"]`)!;const feedback=field.querySelector<HTMLElement>('.question-explanation')!;feedback.hidden=value===null;if(value===null)return;answered++;const right=Number(value)===q.answer;if(right)correct++;field.querySelector('[data-question-status]')!.textContent=right?'本题答对':'本题需回看';});result.textContent=answered?`已回答 ${answered} / ${questions.length} 题，其中 ${correct} 题答对。未作答 ${questions.length-answered} 题。按解析回看具体章节。`:'请先选择至少一道题的答案。';});
 function clear(){form.querySelectorAll<HTMLElement>('.question-explanation').forEach(e=>e.hidden=true);result.textContent='答案已调整，请重新核对。';}
 form.addEventListener('change',clear);form.addEventListener('reset',()=>{clear();result.textContent='已清除本次作答。';});
</script>
