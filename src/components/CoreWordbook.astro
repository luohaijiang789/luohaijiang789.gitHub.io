---
import groups from '../data/english/core-vocabulary.json';
const total=groups.reduce((n,g)=>n+g.entries.length,0);
---
<section class="core-wordbook" aria-label="核心词汇索引"><div class="wordbook-controls"><label>搜索英文、中文或搭配<input type="search" data-core-search placeholder="如 available、预约、access to"/></label><label>按主题查找<select data-core-group><option value="all">全部主题</option>{groups.map(g=><option value={g.id}>{g.label}</option>)}</select></label></div><p data-core-count role="status">共 {total} 条主题词义与搭配。</p>{groups.map(g=><section data-core-section={g.id}><h2>{g.label}</h2><ul class="core-entries">{g.entries.map(e=><li data-core-entry data-core-topic={g.id} data-search={`${e.word} ${e.meaning} ${e.chunk}`.toLowerCase()}><a href={`https://www.merriam-webster.com/dictionary/${encodeURIComponent(e.word)}`} target="_blank" rel="noopener" lang="en">{e.word}</a><span>{e.meaning}</span><span lang="en">{e.chunk}</span></li>)}</ul></section>)}<p data-core-empty hidden>没有匹配的条目。可以缩短关键词或切换到全部主题。</p></section>
<style>.wordbook-controls{display:grid;grid-template-columns:1.6fr 1fr;gap:.8rem;position:sticky;top:calc(var(--sl-nav-height) + .2rem);background:var(--lab-bg);padding:.7rem 0;z-index:2}.wordbook-controls label{display:flex;flex-direction:column;gap:.4rem;font-size:.85rem}.wordbook-controls input,.wordbook-controls select{width:100%;padding:.65rem;border:1px solid var(--lab-border);border-radius:.4rem;background:var(--lab-surface);color:var(--lab-ink);font:inherit}.core-entries{list-style:none;padding:0!important;margin:0!important}.core-entries li{display:grid;grid-template-columns:7.5rem 1.2fr 1.6fr;gap:.6rem;padding:.75rem 0;border-bottom:1px solid var(--lab-border);font-size:.9rem;margin:0!important;align-items:baseline}.core-entries li>*{margin:0!important}.core-entries li>a{font-weight:650;overflow-wrap:anywhere}.core-entries li>span:last-child{color:var(--lab-muted)}[data-core-count]{font-size:.85rem;color:var(--lab-muted)}[hidden]{display:none!important}@media(max-width:620px){.wordbook-controls{grid-template-columns:1fr;position:static}.core-entries li{grid-template-columns:7rem 1fr}.core-entries li>span:last-child{grid-column:1/-1;font-size:.85rem}}
</style>
<script>
 const search=document.querySelector<HTMLInputElement>('[data-core-search]')!;const group=document.querySelector<HTMLSelectElement>('[data-core-group]')!;
 function filter(){const query=search.value.trim().toLocaleLowerCase();let count=0;document.querySelectorAll<HTMLElement>('[data-core-entry]').forEach(entry=>{entry.hidden=!(entry.dataset.search!.includes(query)&&(group.value==='all'||entry.dataset.coreTopic===group.value));if(!entry.hidden)count++;});document.querySelectorAll<HTMLElement>('[data-core-section]').forEach(section=>section.hidden=![...section.querySelectorAll<HTMLElement>('[data-core-entry]')].some(e=>!e.hidden));document.querySelector('[data-core-count]')!.textContent=`匹配 ${count} 条主题词义与搭配。`;document.querySelector<HTMLElement>('[data-core-empty]')!.hidden=count>0;}
 search.addEventListener('input',filter);group.addEventListener('change',filter);
</script>
