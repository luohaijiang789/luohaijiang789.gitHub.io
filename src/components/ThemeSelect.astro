<label class="lab-theme-label"><span class="visually-hidden">选择主题</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M1 20h22M9 16v4m6-4v4"/></svg><select data-lab-theme><option value="dark">深色</option><option value="light">浅色</option><option value="auto" selected>自动</option></select><svg class="chevron" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg></label>
<style>.lab-theme-label{display:flex;position:relative;gap:.35rem;align-items:center;color:var(--sl-color-gray-2);font-size:.875rem}.lab-theme-label select{appearance:none;border:0;padding:.5rem 1.5rem .5rem 0;background:transparent;color:inherit;font:inherit;cursor:pointer;min-width:4rem}.lab-theme-label option{color:var(--lab-ink);background:var(--lab-bg)}.chevron{position:absolute;right:0;pointer-events:none}.visually-hidden{position:absolute;width:1px;height:1px;clip-path:inset(50%);overflow:hidden;white-space:nowrap}</style>
<script>
  type Theme = 'light' | 'dark' | 'auto';
  const parse = (value: string | null): Theme => value === 'light' || value === 'dark' ? value : 'auto';
  let preference: Theme = 'auto';
  try { preference = parse(localStorage.getItem('starlight-theme')); } catch {}
  const media = matchMedia('(prefers-color-scheme: dark)');
  function apply() {
    document.documentElement.dataset.theme = preference === 'auto' ? (media.matches ? 'dark' : 'light') : preference;
    document.querySelectorAll<HTMLSelectElement>('[data-lab-theme]').forEach(select => { select.value = preference; });
  }
  document.querySelectorAll<HTMLSelectElement>('[data-lab-theme]').forEach(select => select.addEventListener('change', () => {
    preference = parse(select.value);
    try { localStorage.setItem('starlight-theme', preference); } catch {}
    apply();
  }));
  media.addEventListener('change', apply);
  window.addEventListener('storage', event => { if (event.key === 'starlight-theme') { preference = parse(event.newValue); apply(); } });
  apply();
</script>
