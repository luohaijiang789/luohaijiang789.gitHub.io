---
import { pathSteps } from '../data/garden';
---
<section class="learning-card" aria-label="学习路径进度">
  <p><strong data-completion-label>0 / 4 步骤完成</strong> · 亲手完成练习后，再勾选。随时可以取消。</p>
  <ul class="task-list">{pathSteps.map(step => <li><label><input type="checkbox" data-path-step={step.id}/><span><strong>{step.title}</strong><br/>{step.detail}</span></label><a href={step.href}>进入这一节</a></li>)}</ul>
  <p class="feedback" data-save-status aria-live="polite">进度仅保存在当前浏览器。</p>
</section>
<script>
  import { pathSteps } from '../data/garden';
  import { readProgress, writeProgress } from '../lib/progress.mjs';
  function renderPath() {
    const p = readProgress();
    document.querySelectorAll<HTMLInputElement>('[data-path-step]').forEach(input => input.checked = p.completed.includes(input.dataset.pathStep!));
    const label = document.querySelector('[data-completion-label]');
    if (label) label.textContent = `${pathSteps.filter(s => p.completed.includes(s.id)).length} / ${pathSteps.length} 步骤完成`;
  }
  document.querySelectorAll<HTMLInputElement>('[data-path-step]').forEach(input => input.addEventListener('change', () => {
    const p = readProgress();
    const id = input.dataset.pathStep!;
    p.completed = input.checked ? [...new Set([...p.completed, id])] : p.completed.filter(s => s !== id);
    const saved = writeProgress(p);
    document.querySelector('[data-save-status]')!.textContent = saved ? '已保存到当前浏览器。可在复习页导出备份。' : '浏览器无法保存进度，请检查存储设置。';
    renderPath();
  }));
  renderPath();
</script>
