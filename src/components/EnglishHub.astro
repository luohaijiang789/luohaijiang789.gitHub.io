---
import Icon from './Icon.astro';
import words from '../data/english/vocabulary.json';
import scenes from '../data/english/scenes.json';
const sections = [
  { icon:'layers', title:'词汇记忆实验室', en:'Vocabulary', description:'一个词，多种入口。拆构词、看图像、编联想、连词族，最后在场景中回忆。', info:`${words.length} 个完整示范 · 6 种学习入口`, href:'/english/vocabulary/' },
  { icon:'globe', title:'日常英语', en:'Everyday life', description:'点餐、问路、购物、租房、改约和闲聊。每个场景都能听、遮挡、替换和复述。', info:`${scenes.length} 个场景 · 单独保存练习`, href:'/english/daily/' },
  { icon:'shield', title:'职场与专业沟通', en:'Work & collaboration', description:'参加晨会、澄清需求、介绍项目，把技术能力变成别人能理解的表达。', info:'从安全晨会开始 · 再到项目介绍', href:'/english/workplace/' },
  { icon:'conversation', title:'听力与口语', en:'Listen & speak', description:'先听懂短句，再跟读、遮挡复述，逐渐离开文字提示。', info:'一段短句 · 三轮输出练习', href:'/english/listening-speaking/' },
  { icon:'book', title:'阅读与写作', en:'Read & write', description:'从短文抓主旨，用自己的话概括，再写清事实、问题与下一步。', info:'原创技术短文 · 写作与修改练习', href:'/english/reading-writing/' },
  { icon:'spark', title:'方法与学习记录', en:'Learn how to learn', description:'方法各有适用范围。用第二天的回忆和实际使用，判断什么对你有帮助。', info:'主动回忆 · 间隔练习 · 迁移', href:'/english/methods/' },
];
---
<div class="english-intro"><span class="eyebrow">FROM KNOWING WORDS TO USING ENGLISH</span><h2>让记忆有线索，让表达有场景。</h2><p>从四级基础出发，一边积累词汇，一边练习在生活和工作里把话说清楚。可以先选一个词，也可以直接进入今天需要的场景。</p><div class="component-actions"><a class="lab-button primary" href="/english/vocabulary/">开始词汇练习</a><a class="lab-button quiet" href="/english/daily/">进入日常场景</a></div></div>
<div class="english-section-grid">{sections.map(section => <a class="english-section-card" href={section.href}><div class="english-section-top"><Icon name={section.icon}/><span>{section.en}</span></div><h3>{section.title}</h3><p>{section.description}</p><small>{section.info}</small></a>)}</div>
<div class="english-routine"><strong>一次短练习：</strong><span>理解一个情境</span><span>找出核心表达</span><span>不看答案复述</span><span>换成自己的内容</span><a href="/review/?topic=vocabulary">留到下一轮复习</a></div>
<style>.english-intro{padding:1.5rem;background:var(--lab-soft);border:1px solid var(--lab-border);border-radius:.8rem}.english-intro h2{font-size:1.6rem!important;line-height:1.6;margin:.5rem 0}.english-intro p{font-size:.95rem;color:var(--lab-muted)}.english-section-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1.4rem}.english-section-card{display:block;padding:1.25rem;border:1px solid var(--lab-border);border-radius:.7rem;color:var(--lab-ink)!important;text-decoration:none!important;background:var(--lab-surface)}.english-section-card:hover{border-color:var(--lab-accent)}.english-section-top{display:flex;align-items:center;justify-content:space-between;color:var(--lab-accent)}.english-section-top span{font-size:.75rem;color:var(--lab-muted)}.english-section-card h3{font-size:1.15rem!important;margin:1rem 0 .5rem!important}.english-section-card p{font-size:.9rem;color:var(--lab-muted);line-height:1.85}.english-section-card small{display:block;font-size:.75rem;color:var(--lab-accent);padding-top:.7rem;border-top:1px solid var(--lab-border)}.english-routine{display:flex;flex-wrap:wrap;gap:.5rem 1rem;padding:1.2rem;border:1px solid var(--lab-border);border-radius:.6rem;margin-top:1.5rem;font-size:.85rem}.english-routine span{color:var(--lab-muted)}@media(max-width:600px){.english-section-grid{grid-template-columns:1fr}.english-intro{padding:1.2rem}.english-intro h2{font-size:1.35rem!important}}</style>
