---
import { sections, lessons } from '../data/english/curriculum.mjs';
import wordbank from '../data/english/core-vocabulary.json';
const entries = wordbank.reduce((n, group) => n + group.entries.length, 0);
---
<div class="course-intro"><span class="eyebrow">ENGLISH · A STRUCTURED HANDBOOK</span><p>从声音到句子，从构词到表达。按章节系统学习，也可以直接查一个具体问题。</p><div class="course-stats"><span><strong>{sections.length}</strong> 个篇章</span><span><strong>{lessons.length}</strong> 节正文与练习</span><span><strong>{entries}</strong> 条核心词义与搭配</span></div><div class="component-actions"><a class="lab-button primary" href="/english/practice/roadmap/">查看学习顺序</a><a class="lab-button quiet" href="/english/practice/checkpoint/">先做综合检查</a><a class="lab-button quiet" href="/english/wordbook/">查核心词汇</a></div><p class="course-progress" data-course-progress>按实际完成的练习记录进度。</p></div>
<div class="english-section-grid">{sections.map((section, i) => <section class="english-section-card"><div class="chapter-label">第 {i + 1} 篇 · {section.units.reduce((n,u)=>n+u.lessons.length,0)} 节</div><h2><a href={`/english/${section.slug}/`}>{section.title}</a></h2><p>{section.description}</p>{section.units.map(unit => <details><summary>{unit.title}<span>{unit.lessons.length} 节</span></summary><ol>{unit.lessons.map(lesson => <li><a href={`/english/${lesson.slug}/`}>{lesson.title}</a></li>)}</ol></details>)}</section>)}</div>
<aside class="course-tools"><strong>辅助练习</strong><p>读完相应文章后，再用<a href="/english/vocabulary/">多方法词汇卡</a>、<a href="/english/daily/">场景对话</a>和<a href="/review/">间隔复习</a>检验理解。发音、语法与构词正文均可独立阅读。</p></aside>
<style>
.course-intro{padding:1.3rem 1.5rem;border:1px solid var(--lab-border);border-radius:.6rem;background:var(--lab-soft)}.course-intro>p{font-size:1.02rem;line-height:1.9}.course-stats{display:flex;flex-wrap:wrap;gap:.7rem 1.5rem;color:var(--lab-muted);font-size:.85rem}.course-stats strong{font-size:1.25rem;color:var(--lab-accent);margin-right:.25rem}.course-progress{font-size:.85rem!important;color:var(--lab-muted)}.english-section-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin:1.4rem 0}.english-section-card{padding:1.25rem;border:1px solid var(--lab-border);border-radius:.6rem;background:var(--lab-surface)}.chapter-label{font-size:.75rem;letter-spacing:.04em;color:var(--lab-muted)}.english-section-card h2{font-size:1.3rem!important;margin:.45rem 0!important}.english-section-card h2 a{text-decoration:none;color:var(--lab-ink)}.english-section-card>p{font-size:.9rem;color:var(--lab-muted);line-height:1.8}.english-section-card details{border:0;border-top:1px solid var(--lab-border);border-radius:0;padding:.7rem 0;margin:0!important}.english-section-card summary{cursor:pointer;display:flex;justify-content:flex-start;gap:.5rem;font-size:.9rem;font-weight:600;color:var(--lab-accent)}.english-section-card summary span{margin-left:auto;font-size:.75rem;color:var(--lab-muted);font-weight:400}.english-section-card ol{padding-left:1.2rem;margin:.6rem 0 0!important;font-size:.85rem}.english-section-card li{padding:.25rem 0}.english-section-card li a{color:var(--lab-ink);text-decoration:none}.english-section-card li a:hover{text-decoration:underline}.course-tools{padding:1rem 1.2rem;border-left:3px solid var(--lab-accent);background:var(--lab-soft);font-size:.9rem}.course-tools p{margin:.4rem 0 0}@media(max-width:650px){.english-section-grid{grid-template-columns:1fr}.course-intro{padding:1.1rem}.course-stats{gap:.6rem 1rem}.english-section-card{padding:1.1rem}}
</style>
<script>
  import { lessons } from '../data/english/curriculum.mjs';
  import { readProgress } from '../lib/progress.mjs';
  function render() { const el=document.querySelector('[data-course-progress]'); if(el) el.textContent=`已自报完成 ${readProgress().english.completedLessons.length} / ${lessons.length} 节练习 · 完成标记不代表自动测定掌握程度。`; }
  render();window.addEventListener('pageshow',render);
</script>
