---
import { reviewCards, reviewTopics } from '../data/english/review-cards.mjs';
---
<section class="learning-card review-deck" aria-labelledby="deck-title">
  <div class="deck-head"><h2 id="deck-title">先回忆，再看答案。</h2><label>卡片范围<select data-review-mode><option value="due">到期与新卡片</option><option value="all">全部卡片 · 自由练习</option></select></label></div>
  <label class="review-topic-label">练习专题<select data-review-topic>{reviewTopics.map(topic => <option value={topic.id}>{topic.label}</option>)}</select></label>
  <p data-deck-summary aria-live="polite"></p>
  <div data-review-card>
    <span class="eyebrow" data-card-kind></span>
    <h3 data-card-cue></h3>
    <div class="component-actions"><button type="button" data-reveal>揭晓参考答案</button></div>
    <div data-answer-panel hidden><p data-card-answer></p><p data-card-note></p><div class="component-actions"><button type="button" data-card-speak>听英文</button><button type="button" data-rate="again">还不熟 · 10 分钟后</button><button type="button" data-rate="remember">记住了 · 稍后复习</button></div></div>
  </div>
  <div data-deck-empty hidden><h3>这一轮完成了。</h3><p>可以切换“全部卡片”继续练习，或者去项目里实际使用刚才的表达。</p><a href="/english/security-standup/">回到英语场景</a></div>
  <p class="feedback" data-review-status role="status"></p>
  <noscript><p>启用 JavaScript 后可以翻卡与保存进度。也可以直接用下面的文本练习。</p>{reviewCards.map(card => <details><summary>{card.cue}</summary><p>{card.answer}</p><p>{card.note}</p></details>)}</noscript>
</section>
<section class="learning-card" aria-labelledby="backup-title">
  <h2 id="backup-title">把进度留在自己手里。</h2>
  <p>学习步骤、章节完成标记、卡片复习、单词笔记和场景草稿保存在当前浏览器。更换设备或清除浏览数据前，请导出 JSON 备份。导入会替换当前进度。</p>
  <div class="component-actions"><button type="button" data-export>导出学习备份</button><label class="import-label">导入备份<input type="file" accept="application/json,.json" data-import/></label></div>
  <p class="feedback" data-backup-status role="status"></p>
</section>
<style>.review-topic-label{display:flex;flex-direction:column;gap:.4rem;font-size:.85rem;margin:1rem 0;max-width:16rem}.review-topic-label select{padding:.6rem;border:1px solid var(--lab-border);border-radius:.4rem;background:var(--lab-bg);color:var(--lab-ink)}.deck-head{display:flex;justify-content:space-between;gap:1rem;align-items:start}.deck-head h2{font-size:1.25rem;margin:0}.deck-head label{font-size:.8rem;display:flex;flex-direction:column;gap:.3rem}.deck-head select{padding:.5rem;border:1px solid var(--lab-border);background:var(--lab-bg);color:var(--lab-ink);border-radius:.4rem}[data-card-cue]{font-size:1.3rem;line-height:1.8;margin:1rem 0}[data-card-answer]{font-size:1.1rem;padding:1rem;background:var(--lab-soft);border-radius:.5rem;white-space:pre-wrap}[data-card-note]{font-size:.9rem}.import-label{display:flex;align-items:center;gap:.6rem;font-size:.875rem;flex-wrap:wrap}.import-label input{max-width:100%;font-size:.8rem}[hidden]{display:none!important}@media(max-width:600px){.deck-head{flex-direction:column}}</style>
<script>
  import { reviewCards, reviewTopics, selectReviewCards } from '../data/english/review-cards.mjs';
  import { readProgress, writeProgress, normalizeProgress, dueCards, rateCard } from '../lib/progress.mjs';
  const mode = document.querySelector<HTMLSelectElement>('[data-review-mode]')!;
  const $ = (selector: string) => document.querySelector<HTMLElement>(selector)!;
  const topic = document.querySelector<HTMLSelectElement>('[data-review-topic]')!;
  const params = new URLSearchParams(location.search);
  if (reviewTopics.some(t => t.id === params.get('topic'))) topic.value = params.get('topic')!;
  const focusId = params.get('card') || '';
  if (reviewCards.some(card => card.id === focusId && (topic.value === 'all' || card.topic === topic.value))) mode.value = 'all';
  let sessionDone = new Set<string>();
  let current: (typeof reviewCards)[number] | undefined;
  function render() {
    const p = readProgress();
    const scoped = selectReviewCards(reviewCards, topic.value, focusId);
    const candidates = mode.value === 'all' ? scoped : dueCards(p, scoped);
    current = candidates.find(c => !sessionDone.has(c.id));
    $('[data-review-card]').hidden = !current;
    $('[data-deck-empty]').hidden = Boolean(current);
    $('[data-answer-panel]').hidden = true;
    $('[data-reveal]').hidden = false;
    $('[data-deck-summary]').textContent = `本轮已练习 ${sessionDone.size} 张 · ${mode.value === 'all' ? '全部卡片练习' : '到期与新卡片'} · 剩余 ${candidates.filter(c => !sessionDone.has(c.id)).length} 张`;
    if (!current) return;
    $('[data-card-kind]').textContent = current.kind;
    $('[data-card-cue]').textContent = current.cue;
    $('[data-card-answer]').textContent = current.answer;
    $('[data-card-note]').textContent = current.note;
    ($('[data-card-speak]') as HTMLButtonElement).disabled = !current.speech || !('speechSynthesis' in window);
    const level = Math.min((p.reviews[current.id]?.level || 0) + 1, 5);
    $('[data-rate="remember"]').textContent = `记住了 · ${[0, 1, 3, 7, 14, 30][level]} 天后`;
  }
  $('[data-reveal]').addEventListener('click', () => { $('[data-answer-panel]').hidden = false; $('[data-reveal]').hidden = true; });
  mode.addEventListener('change', () => { sessionDone = new Set(); render(); });
  topic.addEventListener('change', () => { sessionDone = new Set(); window.speechSynthesis?.cancel(); render(); });
  document.querySelectorAll<HTMLButtonElement>('[data-rate]').forEach(button => button.addEventListener('click', () => {
    if (!current) return;
    const saved = writeProgress(rateCard(readProgress(), current.id, button.dataset.rate === 'remember'));
    if (!saved) { $('[data-review-status]').textContent = '浏览器无法保存进度，当前卡片未标记。请检查存储设置。'; return; }
    sessionDone.add(current.id);
    window.speechSynthesis?.cancel();
    render();
    $('[data-review-status]').textContent = '复习记录已保存。';
    if (current) ($('[data-reveal]') as HTMLButtonElement).focus();
  }));
  $('[data-card-speak]').addEventListener('click', () => {
    if (!current?.speech || !('speechSynthesis' in window)) return;
    speechSynthesis.cancel();
    const line = new SpeechSynthesisUtterance(current.speech); line.lang = 'en-US'; line.rate = .85;
    line.onerror = () => { $('[data-review-status]').textContent = '朗读失败，请检查设备语音设置。'; };
    speechSynthesis.speak(line);
  });
  $('[data-export]').addEventListener('click', () => {
    const blob = new Blob([JSON.stringify(readProgress(), null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob); const a = document.createElement('a');
    a.href = url; a.download = `haijiang-learning-${new Date().toISOString().slice(0, 10)}.json`;
    a.click(); setTimeout(() => URL.revokeObjectURL(url), 1000);
    $('[data-backup-status]').textContent = '备份已生成，请保存下载的 JSON 文件。';
  });
  document.querySelector<HTMLInputElement>('[data-import]')!.addEventListener('change', async e => {
    const input = e.currentTarget as HTMLInputElement; const file = input.files?.[0]; if (!file) return;
    try {
      if (file.size > 1000000) throw new Error('备份文件过大，请选择小于 1 MB 的 JSON 文件。');
      const p = normalizeProgress(JSON.parse(await file.text()));
      if (!window.confirm('导入将替换当前浏览器的学习进度和草稿。确定导入？')) return;
      if (!writeProgress(p)) throw new Error('浏览器无法保存，请检查存储设置。');
      sessionDone = new Set(); render(); $('[data-backup-status]').textContent = '备份已导入。';
    } catch (error) { $('[data-backup-status]').textContent = error instanceof Error ? error.message : '无法读取备份。'; }
    finally { input.value = ''; }
  });
  render();
  window.addEventListener('pagehide', () => window.speechSynthesis?.cancel());
</script>
