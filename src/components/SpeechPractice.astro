<section class="learning-card" aria-labelledby="practice-title">
  <h3 id="practice-title">从听懂，到自己说出来</h3>
  <p>先听一句，再遮住文本复述。朗读使用浏览器语音，声音与可用性取决于设备。</p>
  <div class="practice-line"><p lang="en" data-practice-text>It tried to read a private file. The policy gate blocked the request. Let’s check the logs first.</p></div>
  <div class="component-actions"><button type="button" data-speak-practice>朗读英文</button><button type="button" data-stop-speech>停止朗读</button><button type="button" data-toggle-transcript aria-pressed="false">遮住英文</button></div>
  <p data-speech-status class="feedback" role="status"></p>
  <label for="practice-draft">现在换一个场景：智能体试图修改团队笔记。请写出你的版本。</label>
  <textarea id="practice-draft" rows="4" placeholder="It tried to…" style="width:100%;padding:.8rem;border:1px solid var(--lab-border);border-radius:.5rem;background:var(--lab-bg);color:var(--lab-ink)"></textarea>
  <div class="component-actions"><button type="button" data-save-draft>保存练习草稿</button></div>
  <p class="feedback" data-draft-status role="status">草稿保存在当前浏览器，包含在学习备份中。</p>
</section>
<script>
  import { readProgress, writeProgress } from '../lib/progress.mjs';
  const text = document.querySelector<HTMLElement>('[data-practice-text]')!;
  const draft = document.querySelector<HTMLTextAreaElement>('#practice-draft')!;
  draft.value = readProgress().notes;
  const speak = document.querySelector<HTMLButtonElement>('[data-speak-practice]')!;
  if (!('speechSynthesis' in window)) {
    speak.disabled = true;
    document.querySelector('[data-speech-status]')!.textContent = '当前浏览器不支持朗读。可以看图复述，或自行朗读。';
  }
  speak.addEventListener('click', () => {
    speechSynthesis.cancel();
    const line = new SpeechSynthesisUtterance(text.textContent || '');
    line.lang = 'en-US'; line.rate = .85;
    line.onerror = () => { document.querySelector('[data-speech-status]')!.textContent = '设备未能朗读，请检查系统语音设置。'; };
    speechSynthesis.speak(line);
  });
  document.querySelector('[data-stop-speech]')?.addEventListener('click', () => window.speechSynthesis?.cancel());
  document.querySelector<HTMLButtonElement>('[data-toggle-transcript]')?.addEventListener('click', e => {
    const button = e.currentTarget as HTMLButtonElement;
    const hide = button.getAttribute('aria-pressed') !== 'true';
    text.style.visibility = hide ? 'hidden' : 'visible';
    text.setAttribute('aria-hidden', String(hide));
    button.setAttribute('aria-pressed', String(hide)); button.textContent = hide ? '显示英文' : '遮住英文';
  });
  document.querySelector('[data-save-draft]')?.addEventListener('click', () => {
    const p = readProgress(); p.notes = draft.value;
    document.querySelector('[data-draft-status]')!.textContent = writeProgress(p) ? '草稿已保存。' : '保存失败，请先复制草稿到本地。';
  });
  window.addEventListener('pagehide', () => window.speechSynthesis?.cancel());
</script>
